# -------------------------------------------------------------------------------------------------------------------------------------
# Cargamos las capas raster :
# Escenario Historico:--------------------------
tam_h <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Tmax/Anual/Tmax_Anual_WC.tif")
# Escenario SSP2 4.5 ----------------------------
tam_45 <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_245/2050/Tmax/Anual/Tmax_anual_45.tif")
# Escenario SSP5 5.8 ----------------------------
tam_85 <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_585/2050/Tmax/Anual/Tmax_anual_85.tif")
# promedio del ciclo (mayo a gosto):
par(mfrow=c(2,2))
plot(tam_h, main="temperatura maxima anual | Historico")
plot(tam_45, main="temperatura maxima anual | SSP2-4.5")
plot(tam_85, main="temperatura maxima anual | SSP5-8.5")
summary(tam_h); summary(tam_45); summary(tam_85)
# Parametros de calculos recta para los tres escenarios:
tam_cacao <- tibble(
tam = c(0, 28, 30, 32, 34, 44, 48),
g_aptitud = c(4, 4, 3, 3, 3, 3, 3)
)
tam_cacao1 <- tam_cacao %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tam - lag(tam)),
intercepto = g_aptitud - (pendiente * tam)
)
print(tam_cacao1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
tamlim_28  <- tam_cacao1$tam[2]
tamlim_30 <- tam_cacao1$tam[3]
tamlim_32 <- tam_cacao1$tam[4]
tamlim_34 <- tam_cacao1$tam[5]
tamlim_44 <- tam_cacao1$tam[6]
tamlim_48 <- tam_cacao1$tam[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
tamm28  <- tam_cacao1$pendiente[2]
tamb28  <- tam_cacao1$intercepto[2]
tamm30 <- tam_cacao1$pendiente[3]
tamb30 <- tam_cacao1$intercepto[3]
tamm32 <- tam_cacao1$pendiente[4]
tamb32 <- tam_cacao1$intercepto[4]
tamm34 <- tam_cacao1$pendiente[5]
tamb34 <- tam_cacao1$intercepto[5]
tamm44 <- tam_cacao1$pendiente[6]
tamb44 <- tam_cacao1$intercepto[6]
tamm48 <- tam_cacao1$pendiente[7]
tamb48 <- tam_cacao1$intercepto[7]
# Calculamos el nuevo raster con todo 100% parametrizado | Tres escenario | Ciclo 0508----------------------------
tam_h_a <- ifel(tam_h < tamlim_28,  (tamm28 * tam_h) + tamb28,
ifel(tam_h < tamlim_30, (tamm30 * tam_h) + tamb30,
ifel(tam_h < tamlim_32, (tamm32 * tam_h) + tamb32,
ifel(tam_h < tamlim_34, (tamm34 * tam_h) + tamb34,
ifel(tam_h < tamlim_44, (tamm44 * tam_h) + tamb44,
ifel(tam_h < tamlim_48,(tamm48 * tam_h) + tamb48, NA))))))
tam_45_a <- ifel(tam_45 < tamlim_28,  (tamm28  * tam_45) + tamb28,
ifel(tam_45 < tamlim_30, (tamm30 * tam_45) + tamb30,
ifel(tam_45 < tamlim_32, (tamm32 * tam_45) + tamb32,
ifel(tam_45 < tamlim_34, (tamm34 * tam_45) + tamb34,
ifel(tam_45 < tamlim_44, (tamm44 * tam_45) + tamb44,
ifel(tam_45 < tamlim_48,(tamm48 * tam_45) + tamb48, NA))))))
tam_85_a <- ifel(tam_85 < tamlim_28,  (tamm28  * tam_85) + tamb28,
ifel(tam_85 < tamlim_30, (tamm30 * tam_85) + tamb30,
ifel(tam_85 < tamlim_32, (tamm32 * tam_85) + tamb32,
ifel(tam_85 < tamlim_34, (tamm34 * tam_85) + tamb34,
ifel(tam_85 < tamlim_44, (tamm44 * tam_85) + tamb44,
ifel(tam_85 < tamlim_48,(tamm48 * tam_85) + tamb48, NA))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(tam_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por temperatura maxima del ciclo | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tam_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por temperatura maxima del ciclo | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tam_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por temperatura maxima del ciclo | SSP5 8.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(0:1, 0:1, type = "n", axes = FALSE, xlab = "", ylab = "")
legend("center",
legend = c("No apta", "Marginalmente apta", "Moderadamente apta", "Sumamente apta"), # Tus textos
fill = c("red", "gold", "forestgreen", "dodgerblue"), # Tus colores
title = "Aptitud por temperatura maxima del ciclo", # Título de la leyenda
bty = "n",  # Quitamos la caja alrededor de la leyenda para que se vea limpia
cex = 1.3)  # Aumentamos el tamaño del texto
