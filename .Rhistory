# Parametros:
p_musa <- tibble(
p = c(0, 1000, 1250, 1500, 1800, 2500, 3700),
g_aptitud = c(0, 1, 2, 3, 4, 4, 4)
)
p_musa1 <- p_musa %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (p - lag(p)),
intercepto = g_aptitud - (pendiente * p)
)
print(p_musa1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
plim_1000  <- p_musa1$p[2]
plim_1250  <- p_musa1$p[3]
plim_1500 <- p_musa1$p[4]
plim_1800 <- p_musa1$p[5]
plim_2500 <- p_musa1$p[6]
plim_3700 <- p_musa1$p[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
pm1000  <- p_musa1$pendiente[2]
pb1000  <- p_musa1$intercepto[2]
pm1250  <- p_musa1$pendiente[3]
pb1250  <- p_musa1$intercepto[3]
pm1500 <- p_musa1$pendiente[4]
pb1500 <- p_musa1$intercepto[4]
pm1800 <- p_musa1$pendiente[5]
pb1800 <- p_musa1$intercepto[5]
pm2500 <- p_musa1$pendiente[6]
pb2500 <- p_musa1$intercepto[6]
pm3700 <- p_musa1$pendiente[7]
pb3700 <- p_musa1$intercepto[7]
p_h_anual1 <- ifel(p_h_anual < plim_1000,  (pm1000  * p_h_anual) + pb1000,
ifel(p_h_anual < plim_1250, (pm1250 * p_h_anual) + pb1250,
ifel(p_h_anual < plim_1500, (pm1500 * p_h_anual) + pb1500,
ifel(p_h_anual < plim_1800, (pm1800 * p_h_anual) + pb1800,
ifel(p_h_anual < plim_2500, (pm2500 * p_h_anual) + pb2500,
ifel(p_h_anual < plim_3700, (pm3700 * p_h_anual) + pb3700, NA))))))
p_45_anual1 <- ifel(p_45_anual < plim_1000,  (pm1000  * p_45_anual) + pb1000,
ifel(p_45_anual < plim_1250, (pm1250 * p_45_anual) + pb1250,
ifel(p_45_anual < plim_1500, (pm1500 * p_45_anual) + pb1500,
ifel(p_45_anual < plim_1800, (pm1800 * p_45_anual) + pb1800,
ifel(p_45_anual < plim_2500, (pm2500 * p_45_anual) + pb2500,
ifel(p_45_anual < plim_3700, (pm3700 * p_45_anual) + pb3700, NA))))))
p_85_anual1 <- ifel(p_85_anual < plim_1000,  (pm1000  * p_85_anual) + pb1000,
ifel(p_85_anual < plim_1250, (pm1250 * p_85_anual) + pb1250,
ifel(p_85_anual < plim_1500, (pm1500 * p_85_anual) + pb1500,
ifel(p_85_anual < plim_1800, (pm1800 * p_85_anual) + pb1800,
ifel(p_85_anual < plim_2500, (pm2500 * p_85_anual) + pb2500,
ifel(p_85_anual < plim_3700, (pm3700 * p_85_anual) + pb3700, NA))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(p_h_anual1,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por precipitacion anual | historico", cex.main=1, legend=FALSE )
