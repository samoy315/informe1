# Parametros de calculos recta para los tres escenarios:
tem_grano <- tibble(
tem = c(0, 8, 10, 12, 18, 24, 27, 30, 35),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)
tem_grano1 <- tem_grano %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tem - lag(tem)),
intercepto = g_aptitud - (pendiente * tem)
)
print(tem_grano1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
temlim_08  <- tem_grano1$tem[2]
temlim_10 <- tem_grano1$tem[3]
temlim_12 <- tem_grano1$tem[4]
temlim_18 <- tem_grano1$tem[5]
temlim_24 <- tem_grano1$tem[6]
temlim_27 <- tem_grano1$tem[7]
temlim_30 <- tem_grano1$tem[8]
temlim_35 <- tem_grano1$tem[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
temm08  <- tem_grano1$pendiente[2]
temb08  <- tem_grano1$intercepto[2]
temm10 <- tem_grano1$pendiente[3]
temb10 <- tem_grano1$intercepto[3]
temm12 <- tem_grano1$pendiente[4]
temb12 <- tem_grano1$intercepto[4]
temm18 <- tem_grano1$pendiente[5]
temb18 <- tem_grano1$intercepto[5]
temm24 <- tem_grano1$pendiente[6]
temb24 <- tem_grano1$intercepto[6]
temm27 <- tem_grano1$pendiente[7]
temb27 <- tem_grano1$intercepto[7]
temm30 <- tem_grano1$pendiente[8]
temb30 <- tem_grano1$intercepto[8]
temm35 <- tem_grano1$pendiente[9]
temb35 <- tem_grano1$intercepto[9]
