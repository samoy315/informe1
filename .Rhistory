# promedio del ciclo (mayo a gosto):
par(mfrow=c(2,2))
plot(tem_h, main="Temperatura media anual | Historico")
plot(tem_45, main="Temperatura media anual | SSP2-4.5")
plot(tem_85, main="Temperatura media anual | SSP5-8.5")
summary(tem_h); summary(tem_45); summary(tem_85)
tem_citri <- tibble(
tem = c(0, 13, 16, 19, 26, 33, 36, 39, 42),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)
tem_citri1 <- tem_citri %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tem - lag(tem)),
intercepto = g_aptitud - (pendiente * tem)
)
print(tem_citri1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
temlim_13  <- tem_citri1$tem[2]
temlim_16 <- tem_citri1$tem[3]
temlim_19 <- tem_citri1$tem[4]
temlim_26 <- tem_citri1$tem[5]
temlim_33 <- tem_citri1$tem[6]
temlim_36 <- tem_citri1$tem[7]
temlim_39 <- tem_citri1$tem[8]
temlim_42 <- tem_citri1$tem[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
temm13  <- tem_citri1$pendiente[2]
temb13  <- tem_citri1$intercepto[2]
temm16 <- tem_citri1$pendiente[3]
temb16 <- tem_citri1$intercepto[3]
temm19 <- tem_citri1$pendiente[4]
temb19 <- tem_citri1$intercepto[4]
temm26 <- tem_citri1$pendiente[5]
temb26 <- tem_citri1$intercepto[5]
temm33 <- tem_citri1$pendiente[6]
temb33 <- tem_citri1$intercepto[6]
temm36 <- tem_citri1$pendiente[7]
temb36 <- tem_citri1$intercepto[7]
temm39 <- tem_citri1$pendiente[8]
temb39 <- tem_citri1$intercepto[8]
temm42 <- tem_citri1$pendiente[9]
temb42 <- tem_citri1$intercepto[9]
tem_h_a <- ifel(tem_h < temlim_13,  (temm13 * tem_h) + temb13,
ifel(tem_h < temlim_16, (temm16 * tem_h) + temb16,
ifel(tem_h < temlim_19, (temm19 * tem_h) + temb19,
ifel(tem_h < temlim_26, (temm26 * tem_h) + temb26,
ifel(tem_h < temlim_33, (temm33 * tem_h) + temb33,
ifel(tem_h < temlim_36, (temm36 * tem_h) + temb36,
ifel(tem_h < temlim_39, (temm39 * tem_h) + temb39,
ifel(tem_h < temlim_42, (temm42 * tem_h) + temb42, NA))))))))
tem_45_a <- ifel(tem_45 < temlim_13,  (temm13  * tem_45) + temb13,
ifel(tem_45 < temlim_16, (temm16 * tem_45) + temb16,
ifel(tem_45 < temlim_19, (temm19 * tem_45) + temb19,
ifel(tem_45 < temlim_26, (temm26 * tem_45) + temb26,
ifel(tem_45 < temlim_33, (temm33 * tem_45) + temb33,
ifel(tem_45 < temlim_36, (temm36 * tem_45) + temb36,
ifel(tem_45 < temlim_39, (temm39 * tem_45) + temb39,
ifel(tem_45 < temlim_42, (temm42 * tem_45) + temb42, NA))))))))
tem_85_a <- ifel(tem_85 < temlim_13,  (temm13  * tem_85) + temb13,
ifel(tem_85 < temlim_16, (temm16 * tem_85) + temb16,
ifel(tem_85 < temlim_19, (temm19 * tem_85) + temb19,
ifel(tem_85 < temlim_26, (temm26 * tem_85) + temb26,
ifel(tem_85 < temlim_33, (temm33 * tem_85) + temb33,
ifel(tem_85 < temlim_36, (temm36 * tem_85) + temb36,
ifel(tem_85 < temlim_39, (temm39 * tem_85) + temb39,
ifel(tem_85 < temlim_42, (temm42 * tem_85) + temb42, NA))))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(tem_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | SSP5 8.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(0:1, 0:1, type = "n", axes = FALSE, xlab = "", ylab = "")
legend("center",
legend = c("No apta", "Marginalmente apta", "Moderadamente apta", "Sumamente apta"), # Tus textos
fill = c("red", "gold", "forestgreen", "dodgerblue"), # Tus colores
title = "Aptitud por temperatura media anual", # Título de la leyenda
bty = "n",  # Quitamos la caja alrededor de la leyenda para que se vea limpia
cex = 1.3)  # Aumentamos el tamaño del texto
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(tem_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media anual | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media anual | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media anual | SSP5 8.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(0:1, 0:1, type = "n", axes = FALSE, xlab = "", ylab = "")
legend("center",
legend = c("No apta", "Marginalmente apta", "Moderadamente apta", "Sumamente apta"), # Tus textos
fill = c("red", "gold", "forestgreen", "dodgerblue"), # Tus colores
title = "Aptitud por temperatura media anual", # Título de la leyenda
bty = "n",  # Quitamos la caja alrededor de la leyenda para que se vea limpia
cex = 1.3)  # Aumentamos el tamaño del texto
