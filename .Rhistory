# Parametros de calculos recta para los tres escenarios:
tem_cacao <- tibble(
tem = c(0, 21, 22, 23, 26, 30, 34),
g_aptitud = c(0, 1, 2, 3, 4, 3, 3)
)
tem_cacao1 <- tem_cacao %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tem - lag(tem)),
intercepto = g_aptitud - (pendiente * tem)
)
print(tem_cacao1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
temlim_21  <- tem_cacao1$tem[2]
temlim_22 <- tem_cacao1$tem[3]
temlim_23 <- tem_cacao1$tem[4]
temlim_26 <- tem_cacao1$tem[5]
temlim_30 <- tem_cacao1$tem[6]
temlim_34 <- tem_cacao1$tem[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
temm21  <- tem_cacao1$pendiente[2]
temb21  <- tem_cacao1$intercepto[2]
temm22 <- tem_cacao1$pendiente[3]
temb22 <- tem_cacao1$intercepto[3]
temm23 <- tem_cacao1$pendiente[4]
temb23 <- tem_cacao1$intercepto[4]
temm26 <- tem_cacao1$pendiente[5]
temb26 <- tem_cacao1$intercepto[5]
temm30 <- tem_cacao1$pendiente[6]
temb30 <- tem_cacao1$intercepto[6]
temm34 <- tem_cacao1$pendiente[7]
temb34 <- tem_cacao1$intercepto[7]
# Calculamos el nuevo raster con todo 100% parametrizado | Tres escenario | Ciclo 0508----------------------------
tem_h_a <- ifel(tem_h < temlim_21,  (temm21 * tem_h) + temb21,
ifel(tem_h < temlim_22, (temm22 * tem_h) + temb22,
ifel(tem_h < temlim_23, (temm23 * tem_h) + temb23,
ifel(tem_h < temlim_26, (temm26 * tem_h) + temb26,
ifel(tem_h < temlim_30, (temm30 * tem_h) + temb30,
ifel(tem_h < temlim_34,(temm34 * tem_h) + temb34, NA))))))
tem_45_a <- ifel(tem_45 < temlim_21,  (temm21  * tem_45) + temb21,
ifel(tem_45 < temlim_22, (temm22 * tem_45) + temb22,
ifel(tem_45 < temlim_23, (temm23 * tem_45) + temb23,
ifel(tem_45 < temlim_26, (temm26 * tem_45) + temb26,
ifel(tem_45 < temlim_30, (temm30 * tem_45) + temb30,
ifel(tem_45 < temlim_34,(temm34 * tem_45) + temb34, NA))))))
tem_85_a <- ifel(tem_85 < temlim_21,  (temm21  * tem_85) + temb21,
ifel(tem_85 < temlim_22, (temm22 * tem_85) + temb22,
ifel(tem_85 < temlim_23, (temm23 * tem_85) + temb23,
ifel(tem_85 < temlim_26, (temm26 * tem_85) + temb26,
ifel(tem_85 < temlim_30, (temm30 * tem_85) + temb30,
ifel(tem_85 < temlim_34,(temm34 * tem_85) + temb34, NA))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(tem_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tem_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura media del ciclo | SSP5 8.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(0:1, 0:1, type = "n", axes = FALSE, xlab = "", ylab = "")
legend("center",
legend = c("No apta", "Marginalmente apta", "Moderadamente apta", "Sumamente apta"), # Tus textos
