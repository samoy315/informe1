library(dplyr)
library(terra)
library(ggplot2)
library(sf)
library(tidyterra)
paleta_semaforo <- colorRampPalette(c("red", "orange", "yellow", "green3"))
paleta_semaforo1 <- colorRampPalette(c("red", "gold", "green3", "dodgerblue"))
paleta_temperatura <- colorRampPalette(c("darkblue", "blue", "skyblue", "yellow","orange", "red"))
paleta_precipitacion <- colorRampPalette(c("lightblue", "skyblue", "cornflowerblue", "royalblue", "dodgerblue", 'blue', 'darkblue'))
paleta_dias_secos <- colorRampPalette(c("darkgreen", "green", "palegoldenrod", "yellow", "orange", "red"))
colores_meses <- c("lightblue", "deepskyblue", "lightgreen", "green", "forestgreen", "yellow", "gold", "orange", "tomato", "red", "saddlebrown", "plum")
colores_semaforo1<- (c("red", "orange", "yellow", "green"))
colores_semaforo2<- (c("red", "yellow", "green", "dodgerblue"))
colores_semaforo3<- (c("dodgerblue", "green", "yellow", "red"))
colores_fijos <- c("red", "gold", "green3", "dodgerblue")
cortes_breaks <- c(-Inf, 1, 2, 3.01, Inf)
venezuela <- st_read("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Contorno_Venezuela/AOI_linea_referencia1.shp")
# Escenario Historico:--------------------------
inh_h_anual <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Insolación_horas_mes/Ins_h_anual.tif")
summary(inh_h_anual)
par(mfrow=c(1,1))
plot(inh_h_anual, main="Insolacion - horas al año | Historico")
# Parametros de calculos recta para los tres escenarios:
inh_cana <- tibble(
inh = c(0, 1200, 1400, 1800, 2200, 2600, 3000),
g_aptitud = c(0, 1, 2, 3, 4, 4, 4)
)
inh_cana1 <- inh_cana %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (inh - lag(inh)),
intercepto = g_aptitud - (pendiente * inh)
)
print(inh_cana1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
inhlim_1200  <- inh_cana1$inh[2]
inhlim_1400 <- inh_cana1$inh[3]
inhlim_1800 <- inh_cana1$inh[4]
inhlim_2200 <- inh_cana1$inh[5]
inhlim_2600 <- inh_cana1$inh[6]
inhlim_3000 <- inh_cana1$inh[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
inhm1200  <- inh_cana1$pendiente[2]
inhb1200  <- inh_cana1$intercepto[2]
inhm1400 <- inh_cana1$pendiente[3]
inhb1400 <- inh_cana1$intercepto[3]
inhm1800 <- inh_cana1$pendiente[4]
inhb1800 <- inh_cana1$intercepto[4]
inhm2200 <- inh_cana1$pendiente[5]
inhb2200 <- inh_cana1$intercepto[5]
inhm2600 <- inh_cana1$pendiente[6]
inhb2600 <- inh_cana1$intercepto[6]
inhm3000 <- inh_cana1$pendiente[7]
inhb3000 <- inh_cana1$intercepto[7]
inh_h_a <- ifel(inh_h_anual < inhlim_1200,  (inhm1200 * inh_h_anual) + inhb1200,
ifel(inh_h_anual < inhlim_1400, (inhm1400 * inh_h_anual) + inhb1400,
ifel(inh_h_anual < inhlim_1800, (inhm1800 * inh_h_anual) + inhb1800,
ifel(inh_h_anual < inhlim_2200, (inhm2200 * inh_h_anual) + inhb2200,
ifel(inh_h_anual < inhlim_2600, (inhm2600 * inh_h_anual) + inhb2600,
ifel(inh_h_anual < inhlim_3000,(inhm3000 * inh_h_anual) + inhb3000, NA))))))
inh_45_a<- inh_h_a
inh_85_a<- inh_h_a
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(inh_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por horas al año de insolacion | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(inh_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por horas al año de insolacion | Historico", cex.main=1, legend=true )
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(inh_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por horas al año de insolacion | Historico", cex.main=1, legend=TRUE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
inp_h_anual<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Insolacion_mes_New_LocClim/Ins_anual.tif")
inp_h_anual<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Insolacion_mes_New_LocClim/Ins_anual.tif")
summary(inp_h_anual)
par(mfrow=c(1,1))
plot(inp_h_anual, main="Relacion de insolacion media anual | Historico")
inp_h_anual<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Insolacion_mes_New_LocClim/Ins_anual.tif")
summary(inp_h_anual)
par(mfrow=c(1,1))
plot(inp_h_anual, main="Relacion de insolacion media anual | Historico")
inp_cana <- tibble(
inp = c(0, 20, 30, 40, 50, 60, 70),
g_aptitud = c(0, 1, 2, 3, 4, 4, 4)
)
inp_cana1 <- inp_cana %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (inp - lag(inp)),
intercepto = g_aptitud - (pendiente * inp)
)
print(inp_cana1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
inplim_20  <- inp_cana1$inp[2]
inplim_30 <- inp_cana1$inp[3]
inplim_40 <- inp_cana1$inp[4]
inplim_50 <- inp_cana1$inp[5]
inplim_60 <- inp_cana1$inp[6]
inplim_70 <- inp_cana1$inp[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
inpm20  <- inp_cana1$pendiente[2]
inpb20  <- inp_cana1$intercepto[2]
inpm30 <- inp_cana1$pendiente[3]
inpb30 <- inp_cana1$intercepto[3]
inpm40 <- inp_cana1$pendiente[4]
inpb40 <- inp_cana1$intercepto[4]
inpm50 <- inp_cana1$pendiente[5]
inpb50 <- inp_cana1$intercepto[5]
inpm60 <- inp_cana1$pendiente[6]
inpb60 <- inp_cana1$intercepto[6]
inpm70 <- inp_cana1$pendiente[7]
inpb70 <- inp_cana1$intercepto[7]
# Calculamos el nuevo raster con todo 100% parametrizado  ------ Ciclo 0508 ------------------------------------------
inp_h_b <- ifel(inp_h_anual < inplim_20,  (inpm20  * inp_h_anual) + inpb20,
ifel(inp_h_anual < inplim_30, (inpm30 * inp_h_anual) + inpb30,
ifel(inp_h_anual < inplim_40, (inpm40 * inp_h_anual) + inpb40,
ifel(inp_h_anual < inplim_50, (inpm50 * inp_h_anual) + inpb50,
ifel(inp_h_anual < inplim_60, (inpm60 * inp_h_anual) + inpb60,
ifel(inp_h_anual < inplim_70,(inpm70 * inp_h_anual) + inpb70, NA))))))
inp_45_b<- inp_h_b
inp_85_b<- inp_h_b
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(inp_h_b,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura minima | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(inp_h_b,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por relacion de insolacion media anual | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
