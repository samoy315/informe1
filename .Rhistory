# Parametros:
p_cacao <- tibble(
p = c(0, 1200, 1345, 1455, 2000, 2500, 3500, 4400, 5300),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2 ,1, 0)
)
p_cacao1 <- p_cacao %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (p - lag(p)),
intercepto = g_aptitud - (pendiente * p)
)
print(p_cacao1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
plim_1200  <- p_cacao1$p[2]
plim_1400  <- p_cacao1$p[3]
plim_1600 <- p_cacao1$p[4]
plim_2050 <- p_cacao1$p[5]
plim_2500 <- p_cacao1$p[6]
plim_3500 <- p_cacao1$p[7]
plim_4400 <- p_cacao1$p[8]
plim_5300 <- p_cacao1$p[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
pm1200  <- p_cacao1$pendiente[2]
pb1200  <- p_cacao1$intercepto[2]
pm1400  <- p_cacao1$pendiente[3]
pb1400  <- p_cacao1$intercepto[3]
pm1600 <- p_cacao1$pendiente[4]
pb1600 <- p_cacao1$intercepto[4]
pm2050 <- p_cacao1$pendiente[5]
pb2050 <- p_cacao1$intercepto[5]
pm2500 <- p_cacao1$pendiente[6]
pb2500 <- p_cacao1$intercepto[6]
pm3500 <- p_cacao1$pendiente[7]
pb3500 <- p_cacao1$intercepto[7]
pm4400 <- p_cacao1$pendiente[8]
pb4400 <- p_cacao1$intercepto[8]
pm5300 <- p_cacao1$pendiente[9]
pb5300 <- p_cacao1$intercepto[9]
# Calculamos el nuevo raster con todo 100% parametrizado
p_h_anual1 <- ifel(p_h_anual < plim_1200,  (pm1200  * p_h_anual) + pb1200,
ifel(p_h_anual < plim_1400, (pm1400 * p_h_anual) + pb1400,
ifel(p_h_anual < plim_1600, (pm1600 * p_h_anual) + pb1600,
ifel(p_h_anual < plim_2050, (pm2050 * p_h_anual) + pb2050,
ifel(p_h_anual < plim_2500, (pm2500 * p_h_anual) + pb2500,
ifel(p_h_anual < plim_3500, (pm3500 * p_h_anual) + pb3500,
ifel(p_h_anual < plim_4400, (pm4400 * p_h_anual) + pb4400,
ifel(p_h_anual < plim_5300, (pm5300 * p_h_anual) + pb5300, NA))))))))
p_45_anual1 <- ifel(p_45_anual < plim_1200,  (pm1200  * p_45_anual) + pb1200,
ifel(p_45_anual < plim_1400, (pm1400 * p_45_anual) + pb1400,
ifel(p_45_anual < plim_1600, (pm1600 * p_45_anual) + pb1600,
ifel(p_45_anual < plim_2050, (pm2050 * p_45_anual) + pb2050,
ifel(p_45_anual < plim_2500, (pm2500 * p_45_anual) + pb2500,
ifel(p_45_anual < plim_3500, (pm3500 * p_45_anual) + pb3500,
ifel(p_45_anual < plim_4400, (pm4400 * p_45_anual) + pb4400,
ifel(p_45_anual < plim_5300, (pm5300 * p_45_anual) + pb5300, NA))))))))
p_85_anual1 <- ifel(p_85_anual < plim_1200,  (pm1200  * p_85_anual) + pb1200,
ifel(p_85_anual < plim_1400, (pm1400 * p_85_anual) + pb1400,
ifel(p_85_anual < plim_1600, (pm1600 * p_85_anual) + pb1600,
ifel(p_85_anual < plim_2050, (pm2050 * p_85_anual) + pb2050,
ifel(p_85_anual < plim_2500, (pm2500 * p_85_anual) + pb2500,
ifel(p_85_anual < plim_3500, (pm3500 * p_85_anual) + pb3500,
ifel(p_85_anual < plim_4400, (pm4400 * p_85_anual) + pb4400,
ifel(p_85_anual < plim_5300, (pm5300 * p_85_anual) + pb5300, NA))))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
