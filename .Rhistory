#Parametros:
es_musa <- tibble(
es = c(0, 90, 120, 180, 365),
g_aptitud = c(4, 3, 2, 1, 0)
)
es_musa1 <- es_musa %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (es - lag(es)),
intercepto = g_aptitud - (pendiente * es)
)
print(es_musa1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
eslim_90  <- es_musa1$es[2]
eslim_120  <- es_musa1$es[3]
eslim_180 <- es_musa1$es[4]
eslim_365 <- es_musa1$es[5]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
esm90  <- es_musa1$pendiente[2]
esb90  <- es_musa1$intercepto[2]
esm120  <- es_musa1$pendiente[3]
esb120  <- es_musa1$intercepto[3]
esm180 <- es_musa1$pendiente[4]
esb180 <- es_musa1$intercepto[4]
esm365 <- es_musa1$pendiente[5]
esb365 <- es_musa1$intercepto[5]
es_h_anual1 <- ifel(es_h_anual < eslim_90,  (esm90  * es_h_anual) + esb90,
ifel(es_h_anual < eslim_120, (esm120 * es_h_anual) + esb120,
ifel(es_h_anual < eslim_180, (esm180 * es_h_anual) + esb180,
ifel(es_h_anual < eslim_365, (esm365 * es_h_anual) + esb365, NA))))
es_45_anual2 <- ifel(es_45_anual1 < eslim_90,  (esm90  * es_45_anual1) + esb90,
ifel(es_45_anual1 < eslim_120, (esm120 * es_45_anual1) + esb120,
ifel(es_45_anual1 < eslim_180, (esm180 * es_45_anual1) + esb180,
ifel(es_45_anual1 < eslim_365, (esm365 * es_45_anual1) + esb365, NA))))
es_85_anual2 <- ifel(es_85_anual1 < eslim_90,  (esm90  * es_85_anual1) + esb90,
ifel(es_85_anual1 < eslim_120, (esm120 * es_85_anual1) + esb120,
ifel(es_85_anual1 < eslim_180, (esm180 * es_85_anual1) + esb180,
ifel(es_85_anual1 < eslim_365, (esm365 * es_85_anual1) + esb365, NA))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(es_h_anual1,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por duracion estacion seca | historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(es_45_anual2,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por duracion estacion seca | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(es_85_anual2,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por duracion estacion seca | SSP5-8.5", cex.main=1)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
