plot(tim_85, main="Temperatura minima anual | SSP5-8.5")
# Parametros de calculos recta para los tres escenarios:
tim_cacao <- tibble(
tim = c(0, 10, 13, 15, 20, 24, 28),
g_aptitud = c(0, 1, 2, 3, 4, 4, 4)
)
tim_cacao1 <- tim_cacao %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tim - lag(tim)),
intercepto = g_aptitud - (pendiente * tim)
)
print(tim_cacao1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
timlim_10  <- tim_cacao1$tim[2]
timlim_13 <- tim_cacao1$tim[3]
timlim_15 <- tim_cacao1$tim[4]
timlim_20 <- tim_cacao1$tim[5]
timlim_24 <- tim_cacao1$tim[6]
timlim_28 <- tim_cacao1$tim[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
timm10  <- tim_cacao1$pendiente[2]
timb10  <- tim_cacao1$intercepto[2]
timm13 <- tim_cacao1$pendiente[3]
timb13 <- tim_cacao1$intercepto[3]
timm15 <- tim_cacao1$pendiente[4]
timb15 <- tim_cacao1$intercepto[4]
timm20 <- tim_cacao1$pendiente[5]
timb20 <- tim_cacao1$intercepto[5]
timm24 <- tim_cacao1$pendiente[6]
timb24 <- tim_cacao1$intercepto[6]
timm28 <- tim_cacao1$pendiente[7]
timb28 <- tim_cacao1$intercepto[7]
# Calculamos el nuevo raster con todo 100% parametrizado  ------ Ciclo 0508 ------------------------------------------
tim_h_b <- ifel(tim_h_a < timlim_10,  (timm10  * tim_h_a) + timb10,
ifel(tim_h_a < timlim_13, (timm13 * tim_h_a) + timb13,
ifel(tim_h_a < timlim_15, (timm15 * tim_h_a) + timb15,
ifel(tim_h_a < timlim_20, (timm20 * tim_h_a) + timb20,
ifel(tim_h_a < timlim_24, (timm24 * tim_h_a) + timb24,
ifel(tim_h_a < timlim_28,(timm28 * tim_h_a) + timb28, NA))))))
tim_45_a <- ifel(tim_45 < timlim_10,  (timm10  * tim_45) + timb10,
ifel(tim_45 < timlim_13, (timm13 * tim_45) + timb13,
ifel(tim_45 < timlim_15, (timm15 * tim_45) + timb15,
ifel(tim_45 < timlim_20, (timm20 * tim_45) + timb20,
ifel(tim_45 < timlim_24, (timm24 * tim_45) + timb24,
ifel(tim_45 < timlim_28,(timm28 * tim_45) + timb28, NA))))))
tim_85_a <- ifel(tim_85 < timlim_10,  (timm10  * tim_85) + timb10,
ifel(tim_85 < timlim_13, (timm13 * tim_85) + timb13,
ifel(tim_85 < timlim_15, (timm15 * tim_85) + timb15,
ifel(tim_85 < timlim_20, (timm20 * tim_85) + timb20,
ifel(tim_85 < timlim_24, (timm24 * tim_85) + timb24,
ifel(tim_85 < timlim_28,(timm28 * tim_85) + timb28, NA))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(tim_h_b,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura minima | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tim_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura minima | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(tim_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Temperatura minima | SSP5-8.5", cex.main=1)
