# Cargamos las capas raster:
hr_h_m3<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/HR/HR_Ven_03_ultimo.tif")
hr_h_m4<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/HR/HR_Ven_04.tif")
hr_h_m10<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/HR/HR_Ven_10.tif")
hr_h_m11<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/HR/HR_Ven_11.tif")
par(mfrow=c(1,1))
hr<- c(hr_h_m3, hr_h_m4, hr_h_m10, hr_h_m11)
plot(hr)
hr_h_0304<- 0.5*(hr_h_m3 + hr_h_m4)
hr_h_1011<- 0.5*(hr_h_m10 + hr_h_m11)
summary(hr_h_0304); summary(hr_h_1011)
par(mfrow=c(1,2))
plot(hr_h_0304, main="HR promedio meses marzo y abril")
plot(hr_h_1011, main="HR promedio meses octubre y noviembre")
hr_cana <- tibble(
hr = c(0, 70, 100),
g_aptitud = c(4, 3, 2)
)
hr_cana1 <- hr_cana %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (hr - lag(hr)),
intercepto = g_aptitud - (pendiente * hr)
)
print(hr_cana1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
hrlim_70 <- hr_cana1$hr[2]
hrlim_100 <- hr_cana1$hr[3]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
hrm70  <- hr_cana1$pendiente[2]
hrb70  <- hr_cana1$intercepto[2]
hrm100 <- hr_cana1$pendiente[3]
hrb100 <- hr_cana1$intercepto[3]
# Calculamos el nuevo raster con todo 100% parametrizado  ------ Ciclo 0508 ------------------------------------------
hr_h_0304a <- ifel(hr_h_0304 < hrlim_70,  (hrm70  * hr_h_0304) + hrb70,
ifel(hr_h_0304 < hrlim_100, (hrm100 * hr_h_0304) + hrb100, NA))
hr_45_0304a<- hr_h_0304a
hr_85_0304a<- hr_h_0304a
hr_h_1011a <- ifel(hr_h_1011 < hrlim_70,  (hrm70  * hr_h_1011) + hrb70,
ifel(hr_h_1011 < hrlim_100, (hrm100 * hr_h_1011) + hrb100, NA))
hr_45_1011a<- hr_h_1011a
hr_85_1011a<- hr_h_1011a
par(mfrow = c(2, 1), mar = c(2, 2, 3, 1))
plot(hr_h_0304a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Humedad relativa ciclo lluvias abril | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(hr_h_1011a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Humedad relativa ciclo salidas de lluvias noviembre | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(hr_h_0304a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Humedad relativa ciclo lluvias abril | Historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
par(mfrow = c(1, 1), mar = c(2, 2, 3, 1))
plot(hr_h_1011a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por Humedad relativa ciclo salidas de lluvias noviembre | Historico", cex.main=1, legend=FALSE )
