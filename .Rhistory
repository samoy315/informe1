# ------------------------------------------------------------------------------------------------------------
# -------------------------PRECIPITACION MEDIA ANUAL----------------------------------------------------------
# ------------------------------------------------------------------------------------------------------------
# Cargamos las capas raster:
# Escenario Historico:
p_h<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/Periodo_Base/Precipitacion/Anual/P_Anual_WC.tif")
# Escenario SSP2-4.5:
p_45<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_245/2050/Precipitacion/Anual/p_45_anual.tif")
# Escenario SSP5-8.5:
p_85<- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_585/2050/Precipitacion/Anual/p_85_anual.tif")
par(mfrow=c(2,2))
plot(p_h, main="PP Historico", col=color_fijos1)
plot(p_45, main="PP SSP2-4.5", col=color_fijos1)
plot(p_85, main="PP SSP5-8.5", col=color_fijos1)
summary(p_h); summary(p_45); summary(p_85)
# Parametros:
p_citri <- tibble(
p = c(0, 800, 1000, 1200, 2100, 3000, 3700),
g_aptitud = c(0, 1, 2, 3, 4, 3, 3)
)
p_citri1 <- p_citri %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (p - lag(p)),
intercepto = g_aptitud - (pendiente * p)
)
print(p_citri1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
plim_800  <- p_citri1$p[2]
plim_1000  <- p_citri1$p[3]
plim_1200 <- p_citri1$p[4]
plim_2100 <- p_citri1$p[5]
plim_3000 <- p_citri1$p[6]
plim_3700 <- p_citri1$p[7]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
pm800  <- p_citri1$pendiente[2]
pb800  <- p_citri1$intercepto[2]
pm1000  <- p_citri1$pendiente[3]
pb1000  <- p_citri1$intercepto[3]
pm1200 <- p_citri1$pendiente[4]
pb1200 <- p_citri1$intercepto[4]
pm2100 <- p_citri1$pendiente[5]
pb2100 <- p_citri1$intercepto[5]
pm3000 <- p_citri1$pendiente[6]
pb3000 <- p_citri1$intercepto[6]
pm3700 <- p_citri1$pendiente[7]
pb3700 <- p_citri1$intercepto[7]
# Calculamos el nuevo raster con todo 100% parametrizado
p_h_a <- ifel(p_h < plim_800,  (pm800  * p_h) + pb800,
ifel(p_h < plim_1000, (pm1000 * p_h) + pb1000,
ifel(p_h < plim_1200, (pm1200 * p_h) + pb1200,
ifel(p_h < plim_2100, (pm2100 * p_h) + pb2100,
ifel(p_h < plim_3000, (pm3000 * p_h) + pb3000,
ifel(p_h < plim_3700, (pm3700 * p_h) + pb3700, NA))))))
p_45_a <- ifel(p_45 < plim_800,  (pm800  * p_45) + pb800,
ifel(p_45 < plim_1000, (pm1000 * p_45) + pb1000,
ifel(p_45 < plim_1200, (pm1200 * p_45) + pb1200,
ifel(p_45 < plim_2100, (pm2100 * p_45) + pb2100,
ifel(p_45 < plim_3000, (pm3000 * p_45) + pb3000,
ifel(p_45 < plim_3700, (pm3700 * p_45) + pb3700, NA))))))
p_85_a <- ifel(p_85 < plim_800,  (pm800  * p_85) + pb800,
ifel(p_85 < plim_1000, (pm1000 * p_85) + pb1000,
ifel(p_85 < plim_1200, (pm1200 * p_85) + pb1200,
ifel(p_85 < plim_2100, (pm2100 * p_85) + pb2100,
ifel(p_85 < plim_3000, (pm3000 * p_85) + pb3000,
ifel(p_85 < plim_3700, (pm3700 * p_85) + pb3700, NA))))))
par(mfrow = c(2, 2), mar = c(2, 2, 3, 1))
plot(p_h_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por precipitacion anual | historico", cex.main=1, legend=FALSE )
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(p_45_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por precipitacion anual | SSP2-4.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(p_85_a,breaks = cortes_breaks,col = colores_fijos,main = "Aptitud por precipitacion anual | SSP5-8.5", cex.main=1, legend=FALSE)
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1)
plot(0:1, 0:1, type = "n", axes = FALSE, xlab = "", ylab = "")
legend("center",
legend = c("No apta", "Marginalmente apta", "Moderadamente apta", "Sumamente apta"), # Tus textos
fill = c("red", "gold", "forestgreen", "dodgerblue"), # Tus colores
title = "Aptitud por precipitacion anual", # Título de la leyenda
bty = "n",  # Quitamos la caja alrededor de la leyenda para que se vea limpia
cex = 1.3)  # Aumentamos el tamaño del texto
