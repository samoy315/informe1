library(raster)
library(terra)
library(sf)

indice<- rast("Orto_10cm_apilado.tif")
names(indice)
plot(indice)
bloquecito<- vect("bloquecito1.shp") 
print(bloquecito)
plot(bloquecito,col="blue")
crs_destino<- "EPSG: 32619"
crs(indice, describe= TRUE)
crs(bloquecito, describe=TRUE)
indice_uw<- project(indice, crs_destino, method="bilinear")
crs(indice_uw, describe=TRUE)
plot(indice_uw$Orto_10cm_apilado_1)
plot(bloquecito, add=TRUE)
raster_recortado<- crop(indice_uw, bloquecito)
indice_uw_recortado<- mask(raster_recortado, bloquecito)
plot(indice_uw_recortado, main="indice recortado a bloquecito")
composicion_color<- c(indice_uw_recortado$Orto_10cm_apilado_1, indice_uw_recortado$Orto_10cm_apilado_2, indice_uw_recortado$Orto_10cm_apilado_3)
names(composicion_color)<- c("Rojo", "Verde", "Blue")
plotRGB(composicion_color, r = 1, g = 2, b = 3, stretch= "lin", main="Colores verdaderos")
ndvi<- (indice_uw_recortado$Orto_10cm_apilado_7 - indice_uw_recortado$Orto_10cm_apilado_5) / (indice_uw_recortado$Orto_10cm_apilado_7 + indice_uw_recortado$Orto_10cm_apilado_5)
cgi<- (indice_uw_recortado$Orto_10cm_apilado_7 / indice_uw_recortado$Orto_10cm_apilado_4) - 1
paleta_vegetacion <- colorRampPalette(c("darkred", "yellow", "darkgreen"))(100)

par(mfrow=c(2,1))
plot(ndvi, main="Mapa NDVI", col=paleta_vegetacion)
plot(cgi, main="Mapa CGI", col=paleta_vegetacion)
par(mfrow=c(1,1))
hist(ndvi)

par(mfrow=c(1,1))
