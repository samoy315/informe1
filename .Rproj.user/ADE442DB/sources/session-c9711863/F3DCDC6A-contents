set.seed(42) # Semilla para garantizar reproducibilidad exacta
r_mensual <- rast(nrows = 100, ncols = 100, nlyr = 12)
# Simulamos valores de temperatura entre 25°C y 43°C para las 12 capas
values(r_mensual) <- runif(ncell(r_mensual) * 12, min = 25, max = 43)

# Nombrarmos las capas de enero a diciembre
names(r_mensual) <- c("Ene", "Feb", "Mar", "Abr", "May", "Jun", 
                      "Jul", "Ago", "Sep", "Oct", "Nov", "Dic")

# -------------------------------------------------------------------------
# 2. PROCESAMIENTO: Conteo de meses con temperatura media > 38°C
# -------------------------------------------------------------------------
# Operación vectorizada: Evaluamos la condición (> 38) en todo el Stack 
# y sumamos a lo largo de la dimensión de capas (z-dimension)
raster_conteo <- sum(r_mensual > 38, na.rm = TRUE)

# Opcional: Si deseas asignar NA en aquellas celdas donde TODOS los datos 
# originales eran NA, puedes usar app() para un control más fino.
raster_conteo_limpio <- app(r_mensual, fun = function(x) {
  if (all(is.na(x))) {
    return(NA)
  } else {
    return(sum(x > 38, na.rm = TRUE))
  }
})

