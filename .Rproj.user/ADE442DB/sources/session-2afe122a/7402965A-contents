# 1. DIAGNÓSTICO DE LA CARPETA Y ARCHIVO
# Listamos todos los archivos dentro de la carpeta 'images' para detectar errores de tipeo
archivos_en_carpeta <- list.files("images/")
message("Archivos detectados en la carpeta 'images':")
print(archivos_en_carpeta)

# 2. VALIDACIÓN ESTRICTA DEL ARCHIVO
ruta_exacta <- "images/logo_clima.png"

if(file.exists(ruta_exacta)){
  tamano_kb <- file.info(ruta_exacta)$size / 1024
  message(sprintf("✅ El archivo existe. Tamaño: %.2f KB", tamano_kb))
  
  if(tamano_kb == 0){
    warning("⚠️ El archivo pesa 0 KB. Está vacío o corrupto. Debes volver a guardarlo.")
  }
} else {
  stop("❌ R no encuentra 'logo_clima.png'. Verifica MAYÚSCULAS/minúsculas o si la extensión es .PNG en lugar de .png")
}



# 1. PURGA DE CACHÉ Y ARCHIVOS TEMPORALES
# Esto obliga a Quarto a compilar todo el libro desde cero
carpetas_temporales <- c(".quarto", "_book", "_site", "docs")

for (carpeta in carpetas_temporales) {
  if (dir.exists(carpeta)) {
    unlink(carpeta, recursive = TRUE)
    message(sprintf("✅ Caché purgado: Se eliminó la carpeta temporal '%s'", carpeta))
  }
}



getwd()

# 1. GENERACIÓN DEL ARCHIVO CSS MEDIANTE R
# Este código crea un archivo llamado 'styles.css' y le inyecta la regla de diseño

regla_css <- "
/* Ocultar la imagen del logo SOLO en el bloque del título de la página (derecha) */
header#title-block-header img {
  display: none !important;
}
"

# Escribimos el archivo en el disco
writeLines(regla_css, "styles.css")

# Validamos que se haya creado correctamente
if(file.exists("styles.css")){
  message("✅ ¡Excelente! El archivo 'styles.css' ha sido creado en tu directorio.")
} else {
  warning("⚠️ Hubo un problema al crear el archivo. Verifica tus permisos de escritura.")
}





# 1. REESCRIBIR EL _quarto.yml (El Director de Orquesta)
# Al dejar 'title: ""' vacío, eliminamos el texto de la barra lateral,
# y al poner el logo en 'format', mantenemos la imagen.
yml_global <- c(
  "project:",
  "  type: book",
  "  resources:",
  "    - \"images/\"",
  "",
  "book:",
  "  title: \"\"  # ¡Secreto! Título global vacío para limpiar la barra lateral",
  "  chapters:",
  "    - index.qmd",
  "    - introduccion.qmd",
  "    - summary.qmd",
  "",
  "format:",
  "  html:",
  "    theme: cosmo",
  "    logo: \"images/logo_clima.png\" # El logo en su lugar nativo y correcto"
)
writeLines(yml_global, "_quarto.yml")
message("✅ Archivo _quarto.yml reescrito con éxito.")


# 2. LIMPIAR LA CACHÉ PROFUNDAMENTE
# Destruimos la memoria temporal para obligar a Quarto a leer la nueva configuración
carpetas_cache <- c(".quarto", "_book")
for (carpeta in carpetas_cache) {
  if (dir.exists(carpeta)) {
    unlink(carpeta, recursive = TRUE)
  }
}
message("✅ Caché de Quarto purgada.")



