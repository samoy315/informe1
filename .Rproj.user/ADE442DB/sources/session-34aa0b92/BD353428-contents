# Apilamos todas las covariales ambientales en un objeto stack (apilado):

COV <- stack(topo, cov, precivs, dem30vs, ndvivs, tempovs, tempevs, acrisolvs, alisolvs, drenajevs, suelostvs, suelosfvs, cober1vs,
                geolovs, arenovs, cambivs,ferravs,fluvivs, gleyvs, histo1vs, histo2vs, leptovs, luvivs, Phaevs, Plinthovs) 

# Revisamos los nombres de los campos del objeto COV:

names(COV)

#Gravamos en un archivo RDS los nombres de los campos

namesCOVultimo <- names(COV)

saveRDS(namesCOVultimo, file="namesCOVultimo.rds")

load("idx.rdata")

COV <- COV[[idx]]

writeRaster(COV, filename = "COV040719.tif")

# Juntamos las covariables con los datos puntuales (perfiles de suelos)

# Cargamos los perfiles de suelos:

dat_subset = read.csv(file="p7b.csv", header = T)

# Creamos un objeto nuevo:
dat_subset_sp <- dat_subset

# Asignamos las coordenadas:

coordinates(dat_subset_sp) <- ~ LONV + LATV

dat_sp@proj4string <- cov@crs

dat_sp

dat_sp1 <- cbind(dat, extract(cov, dat_sp))

dat_sp1

str(dat_sp1)

summary(dat_sp1)
# Realizamos un grafico de burbujas reflejando la magnitud del COS en cada perfil de suelo.

# Adicionamos el limites del pais:

lim=readRDS("VEN_adm2.rds")

# Graficamos las burubujas:

bubble(dat_subset_sp, "CO_STOCK", sp.layout = lim)

# Asignamos la projeccion a los perfiles del objeto covariables COV:

dat_subset_sp@proj4string <- COV@crs

# Extraemos los valores de cada covariable ambiental para cada perfil de suelos y lo combinamos con el ID y coordenadas:

dat_subset <- cbind(dat_subset, extract(COV, dat_subset_sp))

# Observamos un resumen estadistico del objeto anteriormente creado:

summary(dat_subset)

#Exportamos los perfiles de suelos con los valores de covariables, es decir la matriz de regersion a un formato *.csv
# para poder visualizar en excel o calc:

write.csv(dat_subset, 'VenezuelaRegMatrix8.csv')

#Guardamos el espacio de trabajo con todos sus objetos, funciones y resultados creados:
save.image("C:/Sevilla/Mario/Venezuela/Corrida_Ven/Vzla_Matriz_Anexo_5.Rdata")


