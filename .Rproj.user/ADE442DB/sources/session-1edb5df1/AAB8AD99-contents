  tam_mc = c(0, 21, 26, 30, 35, 40, 45, 50, 55),
  g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)

tam_mc1 <- tam_mc %>%
  mutate(
    pendiente = (g_aptitud - lag(g_aptitud)) / (tam_mc - lag(tam_mc)),
    intercepto = g_aptitud - (pendiente * tam_mc)
  )
print(tam_mc1)

