# ------------------------------Colores verdes -------------------------------------------------------------

# 1. Creamos un vector con la selección de verdes más usados
mis_verdes <- c(
  "yellowgreen", "chartreuse3", "chartreuse4", 
  "lightgreen", "palegreen2", "palegreen3", 
  "forestgreen", "darkgreen", "green3", "green4",
  "darkseagreen3", "seagreen4", "mediumseagreen"
)

# 2. Configurar márgenes para que se lean bien los nombres
par(mar = c(2, 8, 3, 2))

# 3. Dibujar el gráfico horizontal
barplot(
  rep(1, length(mis_verdes)), 
  col = mis_verdes, 
  names.arg = mis_verdes, 
  horiz = TRUE, 
  las = 1, 
  border = "white",
  main = "Selección de Verdes en R"
)

