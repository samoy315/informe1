  dh = c(0, 13, 15, 16, 24),
  g_aptitud = c(0, 3.5, 4, 3.5, 3)
)

dh_papa1 <- dh_papa %>%
  mutate(
    pendiente = (g_aptitud - lag(g_aptitud)) / (dh - lag(dh)),
    indhcepto = g_aptitud - (pendiente * dh)
  )
print(dh_papa1)

